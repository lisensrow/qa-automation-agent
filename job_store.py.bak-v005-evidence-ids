    )


def upsert_candidate_fact(
    job_id: str,
    case_id: str,
    fact_key: str,
    fact_type: str,
    statement: str,
    data: dict,
    subject_key: str = None,
    source_observation_ids=None,
    verification=None,
):
    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(job_id)

    found_case = None

    for case in job.get("test_cases", []):
        if case.get("case_id") == case_id:
            found_case = case
            break

    if found_case is None:
        raise FileNotFoundError(case_id)

    facts = found_case.setdefault(
        "candidate_facts",
        [],
    )

    existing = None

    for fact in facts:
        if fact.get("fact_key") == fact_key:
            existing = fact
            break

    now = _now()

    if existing is None:
        existing = {
            "candidate_id": (
                "fact-"
                + uuid.uuid4().hex[:10]
            ),
            "fact_key": fact_key,
            "subject_key": (
                str(subject_key).strip()
                if subject_key
                else None
            ),
            "status": "candidate",
            "fact_type": str(fact_type).strip(),
            "statement": str(statement).strip(),
            "data": deepcopy(data),
            "source_observation_ids": [],
            "verification": {},
            "created_at": now,
            "first_seen_at": now,
            "last_seen_at": now,
        }

        facts.append(existing)

    else:
        if subject_key:
            existing["subject_key"] = (
                str(subject_key).strip()
            )

        existing["statement"] = (
            str(statement).strip()
        )
        existing["data"] = deepcopy(data)
        existing["last_seen_at"] = now

    old_sources = existing.setdefault(
        "source_observation_ids",
        [],
    )

    for obs_id in (
        source_observation_ids or []
    ):
        if (
            obs_id
            and obs_id not in old_sources
        ):
            old_sources.append(obs_id)

    old_verification = existing.setdefault(
        "verification",
        {},
    )

    for key, value in (
        verification or {}
    ).items():
        if isinstance(value, bool):
            old_verification[key] = bool(
                old_verification.get(
                    key,
                    False,
                )
                or value
            )
        else:
            old_verification[key] = value

    save_job(job)

    return deepcopy(existing)


def list_jobs(limit: int = 20):
    _ensure_storage()

    try:
        limit = int(limit)
    except Exception:
        limit = 20

    limit = max(
        1,
        min(limit, 100),
    )

    jobs = []

    for path in JOBS_DIR.glob(
        "*.json"
    ):
        try:
            data = json.loads(
                path.read_text(
                    encoding="utf-8"
                )
            )

            jobs.append(data)

        except Exception:
            continue

    jobs.sort(
        key=lambda item: item.get(
            "created_at",
            "",
        ),
        reverse=True,
    )

    return jobs[:limit]
