from tools.browser import open_page, get_state


TOOLS = [
    {
        "type": "function",
        "function": {
            "name": "browser_open_page",
            "description": (
                "Открывает URL в постоянной изолированной браузерной "
                "сессии Chromium через Playwright. Браузерная сессия "
                "сохраняется между последующими tool-вызовами."
            ),
            "parameters": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": (
                            "Полный URL, например "
                            "https://uc.lab.local"
                        )
                    }
                },
                "required": ["url"]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "browser_get_state",
            "description": (
                "Получает текущее состояние уже открытой браузерной "
                "сессии без новой навигации: URL, title, текст страницы, "
                "ошибки и новый реальный screenshot."
            ),
            "parameters": {
                "type": "object",
                "properties": {}
            }
        }
    }
]


def execute_tool(name: str, arguments: dict):
    if name == "browser_open_page":
        return open_page(arguments["url"])

    if name == "browser_get_state":
        return get_state()

    return {
        "error": f"Unknown tool: {name}"
    }
