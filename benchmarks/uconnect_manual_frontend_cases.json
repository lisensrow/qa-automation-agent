      "execution_status": "ready",
      "policy_required": true,
      "cleanup_contract": "clear_filter_v1",
      "prerequisites": ["saved_stand", "filter_field", "filter_value", "filter_column"],
      "checks": ["filter control contains the requested value", "visible rows satisfy the filter", "filter control is cleared", "clearing the filter restores the prior visible table"],
      "check_contracts": {
        "planned-001": {"tool": "browser_inspect_semantic", "subject_binding": "filter_field", "value_binding": "filter_value", "phase": "filtered", "assertions": [{"field": "value_matches_binding", "operator": "eq", "expected": true}]},
        "planned-002": {"tool": "browser_inspect_table_semantic", "subject_binding": "filter_field", "value_binding": "filter_value", "column_binding": "filter_column", "phase": "filtered", "assertions": [{"field": "rows_match_binding", "operator": "eq", "expected": true}]},
        "planned-003": {"tool": "browser_inspect_semantic", "subject_binding": "filter_field", "value_binding": "filter_value", "phase": "restored", "assertions": [{"field": "value_empty", "operator": "eq", "expected": true}]},
        "planned-004": {"tool": "browser_inspect_table_semantic", "subject_binding": "filter_field", "value_binding": "filter_value", "column_binding": "filter_column", "phase": "restored", "assertions": [{"field": "rows_restored", "operator": "eq", "expected": true}]}
      }
