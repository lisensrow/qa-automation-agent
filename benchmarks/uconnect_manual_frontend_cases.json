        "planned-002": {"tool": "browser_open_exact_table_row_details_semantic", "subject_binding": "exact_ci_name", "assertions": [{"field": "details_identity_passed", "operator": "eq", "expected": true}, {"field": "row_opened", "operator": "eq", "expected": true}]},
        "planned-003": {"tool": "browser_open_exact_table_row_details_semantic", "subject_binding": "exact_ci_name", "assertions": [{"field": "url", "operator": "same_origin"}]}
      }
    },
