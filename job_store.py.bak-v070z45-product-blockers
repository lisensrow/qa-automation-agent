    if job is None:
        raise FileNotFoundError(
            job_id
        )

    found = None

    for case in job.get(
        "test_cases",
        []
    ):
        if case.get("case_id") == case_id:
            found = case
            break

    if found is None:
        raise FileNotFoundError(
            case_id
        )

    if isinstance(
        observation_ids,
