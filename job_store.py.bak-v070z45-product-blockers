def upsert_candidate_fact(
    job_id: str,
    case_id: str,
    fact_key: str,
    fact_type: str,
    statement: str,
    data: dict,
    subject_key: str = None,
    source_observation_ids=None,
    verification=None,
):
    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(job_id)

    found_case = None

    for case in job.get("test_cases", []):
        if case.get("case_id") == case_id:
            found_case = case
            break

    if found_case is None:
        raise FileNotFoundError(case_id)

    facts = found_case.setdefault(
        "candidate_facts",
        [],
    )

    existing = None

    for fact in facts:
        if fact.get("fact_key") == fact_key:
            existing = fact
            break

    now = _now()

    if existing is None:
        existing = {
            "candidate_id": (
                "fact-"
                + uuid.uuid4().hex[:10]
            ),
            "fact_key": fact_key,
            "subject_key": (
                str(subject_key).strip()
                if subject_key
                else None
            ),
            "status": "candidate",
            "fact_type": str(fact_type).strip(),
            "statement": str(statement).strip(),
            "data": deepcopy(data),
            "source_observation_ids": [],
            "verification": {},
            "created_at": now,
            "first_seen_at": now,
            "last_seen_at": now,
        }

        facts.append(existing)

    else:
        if subject_key:
            existing["subject_key"] = (
                str(subject_key).strip()
            )

        existing["statement"] = (
            str(statement).strip()
        )
        existing["data"] = deepcopy(data)
        existing["last_seen_at"] = now

    old_sources = existing.setdefault(
        "source_observation_ids",
        [],
    )

    for obs_id in (
        source_observation_ids or []
    ):
        if (
            obs_id
            and obs_id not in old_sources
        ):
            old_sources.append(obs_id)

    old_verification = existing.setdefault(
        "verification",
        {},
    )

    for key, value in (
        verification or {}
    ).items():
        if isinstance(value, bool):
            old_verification[key] = bool(
                old_verification.get(
                    key,
                    False,
                )
                or value
            )
        else:
            old_verification[key] = value

    save_job(job)

    return deepcopy(existing)


def _find_test_resource(job: dict, resource_id: str):
    resource_id = str(resource_id or "").strip()

    if not resource_id:
        raise ValueError(
            "resource_id missing"
        )

    for resource in job.get(
        "resources",
        [],
    ):
        if resource.get("resource_id") == resource_id:
            return resource

    return None


def _validate_resource_case(job: dict, case_id: str):
    if case_id is None:
        return None

    case_id = str(case_id).strip()

    if not case_id:
        return None

    if not any(
        case.get("case_id") == case_id
        for case in job.get("test_cases", [])
    ):
        raise FileNotFoundError(
            case_id
        )

    return case_id


def _normalize_resource_dependencies(
    job: dict,
    depends_on=None,
    resource_id: str = None,
):
    if depends_on is None:
        return []

    if isinstance(depends_on, str):
        depends_on = [depends_on]

    if not isinstance(depends_on, list):
        raise ValueError(
            "depends_on must be list"
        )

    known_ids = {
        item.get("resource_id")
        for item in job.get("resources", [])
        if item.get("resource_id")
    }

    normalized = []

    for value in depends_on:
        dependency_id = str(
            value or ""
        ).strip()

        if not dependency_id:
            continue

        if dependency_id == resource_id:
            raise ValueError(
                "resource cannot depend on itself"
            )

        if dependency_id not in known_ids:
            raise FileNotFoundError(
                dependency_id
            )

        if dependency_id not in normalized:
            normalized.append(
                dependency_id
            )

    if resource_id is not None:
        graph = {
            item.get("resource_id"): list(
                item.get("depends_on") or []
            )
            for item in job.get("resources", [])
            if item.get("resource_id")
        }
        graph[resource_id] = normalized
        visiting = set()
        visited = set()

        def visit(node_id):
            if node_id in visited:
                return

            if node_id in visiting:
                raise ValueError(
                    "resource dependency cycle"
                )

            visiting.add(node_id)

            for dependency_id in graph.get(
                node_id,
                [],
            ):
                if dependency_id in graph:
                    visit(dependency_id)

            visiting.remove(node_id)
            visited.add(node_id)

        for node_id in graph:
            visit(node_id)

    return normalized


def _refresh_cleanup_status(job: dict):
    relevant = [
        resource
        for resource in job.get("resources", [])
        if resource.get("cleanup_required")
    ]

    if not relevant:
        status = "not_required"
    else:
        statuses = {
            str(resource.get("status") or "active")
            for resource in relevant
        }

        if "cleanup_in_progress" in statuses:
            status = "running"
        elif "cleanup_failed" in statuses:
            status = "failed"
        elif statuses & {
            "active",
            "cleanup_pending",
        }:
            status = "pending"
        else:
            status = "completed"

    job["cleanup_status"] = status

    if status == "running":
        if not job.get("cleanup_started_at"):
            job["cleanup_started_at"] = _now()
        job["cleanup_finished_at"] = None
    elif status in {
        "completed",
        "not_required",
    }:
        if (
            job.get("cleanup_started_at")
            and not job.get("cleanup_finished_at")
        ):
            job["cleanup_finished_at"] = _now()
    else:
        job["cleanup_finished_at"] = None

    return status


def add_test_resource(
    job_id: str,
    resource_type: str,
    name: str = None,
    external_id: str = None,
    created_by_case: str = None,
    cleanup_required: bool = True,
    metadata: dict = None,
    depends_on=None,
):
    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(
            job_id
        )

    resource_type = str(
        resource_type or ""
    ).strip().lower()

    if not resource_type:
        raise ValueError(
            "resource_type missing"
        )

    name = (
        str(name).strip()
        if name is not None
        else None
    ) or None

    external_id = (
        str(external_id).strip()
        if external_id is not None
        else None
    ) or None

    if not name and not external_id:
        raise ValueError(
            "resource name or external_id required"
        )

    created_by_case = _validate_resource_case(
        job,
        created_by_case,
    )

    if not isinstance(cleanup_required, bool):
        raise ValueError(
            "cleanup_required must be bool"
        )

    if metadata is None:
        metadata = {}

    if not isinstance(metadata, dict):
        raise ValueError(
            "resource metadata must be dict"
        )

    depends_on = _normalize_resource_dependencies(
        job,
        depends_on,
    )

    now = _now()

    resource = {
        "resource_id": (
            "res-"
            + uuid.uuid4().hex[:12]
        ),
        "type": resource_type,
        "name": name,
        "external_id": external_id,
        "created_by_case": created_by_case,
        "status": "active",
        "cleanup_required": cleanup_required,
        "depends_on": depends_on,
        "cleanup_attempts": [],
        "metadata": _sanitize_resource_metadata(
            metadata
        ),
        "created_at": now,
        "updated_at": now,
        "cleaned_at": None,
        "last_updated_by_case": created_by_case,
    }

    job.setdefault(
        "resources",
        [],
    ).append(resource)

    _refresh_cleanup_status(job)
    save_job(job)

    return deepcopy(resource)


