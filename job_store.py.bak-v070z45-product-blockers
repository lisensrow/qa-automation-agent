def list_cleanup_candidates(job_id: str):
    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(
            job_id
        )

    pending_statuses = {
        "active",
        "cleanup_pending",
        "cleanup_in_progress",
        "cleanup_failed",
    }

    return [
        deepcopy(resource)
        for resource in job.get("resources", [])
        if resource.get("cleanup_required")
        and str(
            resource.get("status")
            or "active"
        ) in pending_statuses
    ]


def _find_cleanup_attempt(
    resource: dict,
    attempt_id: str,
):
    attempt_id = str(
        attempt_id or ""
    ).strip()

    if not attempt_id:
        raise ValueError(
            "attempt_id missing"
        )

    for attempt in resource.get(
        "cleanup_attempts",
        [],
    ):
        if attempt.get("attempt_id") == attempt_id:
            return attempt

    return None


def _compact_cleanup_value(value):
    value = _sanitize_resource_metadata(
        value
    )

    if isinstance(value, str):
        return value[:1500]

    if isinstance(value, list):
        return [
            _compact_cleanup_value(item)
            for item in value[:25]
        ]

    if isinstance(value, dict):
        return {
            str(key)[:200]: _compact_cleanup_value(item)
            for key, item in list(value.items())[:50]
        }

    return value


def start_cleanup_attempt(
    job_id: str,
    resource_id: str,
):
    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(
            job_id
        )

    resource = _find_test_resource(
        job,
        resource_id,
    )

    if resource is None:
        raise FileNotFoundError(
            resource_id
        )

    if not resource.get("cleanup_required"):
        raise ValueError(
            "resource does not require cleanup"
        )

    if resource.get("status") in {
        "cleaned",
        "retained",
    }:
        raise ValueError(
            "resource cleanup already closed"
        )

    now = _now()
    attempts = resource.setdefault(
        "cleanup_attempts",
        [],
    )

    for previous in attempts:
        if previous.get("status") == "running":
            previous["status"] = "interrupted"
            previous["finished_at"] = now
            previous["reason"] = (
                "superseded_by_resumed_cleanup"
            )

    attempt = {
        "attempt_id": (
            "cleanup-"
            + uuid.uuid4().hex[:12]
        ),
        "status": "running",
        "started_at": now,
        "finished_at": None,
        "reason": None,
        "events": [],
        "result": None,
    }

    attempts.append(attempt)
    resource["status"] = "cleanup_in_progress"
    resource["updated_at"] = now

    if not job.get("cleanup_started_at"):
        job["cleanup_started_at"] = now

    _refresh_cleanup_status(job)
    save_job(job)

    return deepcopy(attempt)


def add_cleanup_attempt_event(
    job_id: str,
    resource_id: str,
    attempt_id: str,
    event: dict,
):
    if not isinstance(event, dict):
        raise ValueError(
            "cleanup event must be dict"
        )

    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(
            job_id
        )

    resource = _find_test_resource(
        job,
        resource_id,
    )

    if resource is None:
        raise FileNotFoundError(
            resource_id
        )

    attempt = _find_cleanup_attempt(
        resource,
        attempt_id,
    )

    if attempt is None:
        raise FileNotFoundError(
            attempt_id
        )

    if attempt.get("status") != "running":
        raise ValueError(
            "cleanup attempt is not running"
        )

    stored = {
        "event_id": (
            "ce-"
            + uuid.uuid4().hex[:10]
        ),
        "created_at": _now(),
        "data": _compact_cleanup_value(
            event
        ),
    }

    attempt.setdefault(
        "events",
        [],
    ).append(stored)
    resource["updated_at"] = stored[
        "created_at"
    ]

    save_job(job)

    return deepcopy(stored)


def finish_cleanup_attempt(
    job_id: str,
    resource_id: str,
    attempt_id: str,
    outcome: str,
    reason: str = None,
    result: dict = None,
):
    outcome = str(
        outcome or ""
    ).strip().lower()

    if outcome not in {
        "cleaned",
        "pending",
        "failed",
    }:
        raise ValueError(
            f"invalid cleanup outcome: {outcome}"
        )

    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(
            job_id
        )

    resource = _find_test_resource(
        job,
        resource_id,
    )

    if resource is None:
        raise FileNotFoundError(
            resource_id
        )

    attempt = _find_cleanup_attempt(
        resource,
        attempt_id,
    )

    if attempt is None:
        raise FileNotFoundError(
            attempt_id
        )

    if attempt.get("status") != "running":
        raise ValueError(
            "cleanup attempt is not running"
        )

    now = _now()
    attempt["status"] = outcome
    attempt["finished_at"] = now
    attempt["reason"] = (
        str(reason)[:1500]
        if reason is not None
        else None
    )
    attempt["result"] = (
        _compact_cleanup_value(result)
        if isinstance(result, dict)
        else None
    )

    resource["status"] = {
        "cleaned": "cleaned",
        "pending": "cleanup_pending",
        "failed": "cleanup_failed",
    }[outcome]
    resource["updated_at"] = now

    if outcome == "cleaned":
        resource["cleaned_at"] = now

    _refresh_cleanup_status(job)
    save_job(job)

    return deepcopy(resource)



def list_jobs(limit: int = 20):
    _ensure_storage()

    try:
        limit = int(limit)
    except Exception:
        limit = 20

    limit = max(
        1,
        min(limit, 100),
    )

    jobs = []

    for path in JOBS_DIR.glob(
        "*.json"
    ):
        try:
            data = json.loads(
                path.read_text(
                    encoding="utf-8"
                )
            )

            jobs.append(data)

        except Exception:
            continue

    jobs.sort(
        key=lambda item: item.get(
            "created_at",
            "",
        ),
        reverse=True,
    )

    return jobs[:limit]
