def list_test_resources(
    job_id: str,
    status: str = None,
    cleanup_required=None,
    created_by_case: str = None,
):
    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(
            job_id
        )

    if status is not None:
        status = str(status).strip().lower()

        if status not in VALID_RESOURCE_STATUSES:
            raise ValueError(
                f"invalid resource status: {status}"
            )

    if cleanup_required is not None and not isinstance(
        cleanup_required,
        bool,
    ):
        raise ValueError(
            "cleanup_required must be bool"
        )

    if created_by_case is not None:
        created_by_case = str(
            created_by_case
        ).strip() or None

    resources = []

    for resource in job.get(
        "resources",
        [],
    ):
        if (
            status is not None
            and resource.get("status") != status
        ):
            continue

        if (
            cleanup_required is not None
            and bool(
                resource.get(
                    "cleanup_required"
                )
            ) != bool(cleanup_required)
        ):
            continue

        if (
            created_by_case is not None
            and resource.get(
                "created_by_case"
            ) != created_by_case
        ):
            continue

        resources.append(
            deepcopy(resource)
        )

    return resources


def update_test_resource(
    job_id: str,
    resource_id: str,
    status: str = None,
    name: str = None,
    external_id: str = None,
    cleanup_required=None,
    metadata: dict = None,
    depends_on=None,
    updated_by_case: str = None,
):
    job = get_job(job_id)

    if job is None:
        raise FileNotFoundError(
            job_id
        )

    resource = _find_test_resource(
        job,
        resource_id,
    )

    if resource is None:
        raise FileNotFoundError(
            resource_id
        )

    updated_by_case = _validate_resource_case(
        job,
        updated_by_case,
    )

    if status is not None:
        status = str(status).strip().lower()

        if status not in VALID_RESOURCE_STATUSES:
            raise ValueError(
                f"invalid resource status: {status}"
            )

        resource["status"] = status

        if status == "cleaned":
            resource["cleaned_at"] = _now()

    if name is not None:
        resource["name"] = (
            str(name).strip()
            or None
        )

    if external_id is not None:
        resource["external_id"] = (
            str(external_id).strip()
            or None
        )

    if cleanup_required is not None:
        if not isinstance(cleanup_required, bool):
            raise ValueError(
                "cleanup_required must be bool"
            )

        resource["cleanup_required"] = cleanup_required

    if metadata is not None:
        if not isinstance(metadata, dict):
            raise ValueError(
                "resource metadata must be dict"
            )

        stored_metadata = resource.setdefault(
            "metadata",
            {},
        )

        stored_metadata.update(
            _sanitize_resource_metadata(
                metadata
            )
        )

    if depends_on is not None:
        resource["depends_on"] = (
            _normalize_resource_dependencies(
                job,
                depends_on,
                resource_id=resource_id,
            )
        )

    if updated_by_case is not None:
        resource["last_updated_by_case"] = (
            updated_by_case
        )

    resource["updated_at"] = _now()

    _refresh_cleanup_status(job)
    save_job(job)

    return deepcopy(resource)



