import re
import sqlite3
from datetime import datetime, timezone
from pathlib import Path

from docx import Document
from docx.document import Document as _Document
from docx.table import Table
from docx.text.paragraph import Paragraph
from docx.oxml.table import CT_Tbl
from docx.oxml.text.paragraph import CT_P


SOURCE_DIR = Path("/opt/uqa/knowledge/source")
DB_PATH = Path("/opt/uqa/knowledge/index/knowledge.db")

TARGET_CHUNK_CHARS = 2400
MAX_CHUNK_CHARS = 3600
OVERLAP_BLOCKS = 2


def _now():
    return datetime.now(timezone.utc).isoformat()


def _normalize_text(text: str) -> str:
    text = text.replace("\xa0", " ")
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def _iter_docx_blocks(doc):
    if isinstance(doc, _Document):
        parent = doc.element.body
    else:
        raise ValueError("Unsupported DOCX parent")

    for child in parent.iterchildren():
        if isinstance(child, CT_P):
            yield Paragraph(child, doc)

        elif isinstance(child, CT_Tbl):
            yield Table(child, doc)


def _read_docx(path: Path):
    doc = Document(path)

    blocks = []
    current_heading = ""

    for item in _iter_docx_blocks(doc):
        if isinstance(item, Paragraph):
            text = _normalize_text(item.text)

            if not text:
                continue

            style_name = ""

            try:
                if item.style:
                    style_name = (
                        item.style.name or ""
                    ).lower()
            except Exception:
                pass

            is_heading = (
                style_name.startswith("heading")
                or style_name.startswith("заголовок")
            )

            if is_heading:
                current_heading = text

                blocks.append(
                    {
                        "heading": current_heading,
                        "text": text,
                        "type": "heading",
                    }
                )
            else:
                blocks.append(
                    {
                        "heading": current_heading,
                        "text": text,
                        "type": "paragraph",
                    }
                )

        elif isinstance(item, Table):
            for row in item.rows:
                cells = []

                for cell in row.cells:
                    value = _normalize_text(
                        cell.text
                    )

                    if value:
                        cells.append(value)

                if cells:
                    blocks.append(
                        {
                            "heading": current_heading,
                            "text": " | ".join(cells),
                            "type": "table",
                        }
                    )

    return blocks


def _read_text(path: Path):
    text = path.read_text(
        encoding="utf-8",
        errors="replace",
    )

    blocks = []
    current_heading = ""

    for raw in text.splitlines():
        line = _normalize_text(raw)

        if not line:
            continue

        if line.startswith("#"):
            heading = line.lstrip("#").strip()

            if heading:
                current_heading = heading

        blocks.append(
            {
                "heading": current_heading,
                "text": line,
                "type": "text",
            }
        )

    return blocks


def read_document(path: Path):
    suffix = path.suffix.lower()

    if suffix == ".docx":
        return _read_docx(path)

    if suffix in (
        ".md",
        ".txt",
    ):
        return _read_text(path)

    raise ValueError(
        f"Unsupported file type: {suffix}"
    )


def make_chunks(blocks):
    # Сначала делим документ на логические секции
    # по заголовкам. Разные разделы документа не должны
    # попадать в один chunk только потому, что они короткие.
    sections = []

    current_heading = ""
    current_section = []

    for block in blocks:
        if block.get("type") == "heading":
            if current_section:
                sections.append(
                    (
                        current_heading,
                        current_section,
                    )
                )

            current_heading = (
                block.get("heading")
                or block.get("text", "")
            )

            current_section = [block]

        else:
            current_section.append(block)

    if current_section:
        sections.append(
            (
                current_heading,
                current_section,
            )
        )

    chunks = []

    for heading, section_blocks in sections:
        current = []
        current_chars = 0

        def emit():
            nonlocal current
            nonlocal current_chars

            if not current:
                return

            content = "\n".join(
                item["text"]
                for item in current
            ).strip()

            if content:
                chunks.append(
                    {
                        "heading": heading,
                        "content": content,
                    }
                )

            # Небольшой overlap только внутри
            # одной и той же секции.
            overlap = [
                item
                for item in current[-OVERLAP_BLOCKS:]
                if item.get("type") != "heading"
            ]

            current = list(overlap)

            current_chars = sum(
                len(item["text"]) + 1
                for item in current
            )

        for block in section_blocks:
            block_text = block["text"]

            # Очень большой одиночный абзац.
            if len(block_text) > MAX_CHUNK_CHARS:
                if current:
                    emit()

                    # После emit overlap здесь не нужен.
                    current = []
                    current_chars = 0

                start_pos = 0

                while start_pos < len(block_text):
                    end_pos = (
                        start_pos
                        + TARGET_CHUNK_CHARS
                    )

                    piece = block_text[
                        start_pos:end_pos
                    ]

                    chunks.append(
                        {
                            "heading": heading,
                            "content": piece,
                        }
                    )

                    start_pos = end_pos

                continue

            if (
                current
                and current_chars
                + len(block_text)
                > TARGET_CHUNK_CHARS
            ):
                emit()

                # Если overlap сам по себе слишком
                # большой для следующего блока,
                # отбрасываем overlap.
                if (
                    current_chars
                    + len(block_text)
                    > MAX_CHUNK_CHARS
                ):
                    current = []
                    current_chars = 0

            current.append(block)

            current_chars += (
                len(block_text) + 1
            )

        if current:
            content = "\n".join(
                item["text"]
                for item in current
            ).strip()

            if content:
                chunks.append(
                    {
                        "heading": heading,
                        "content": content,
                    }
                )

    return chunks



def _connect():
    DB_PATH.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    con = sqlite3.connect(DB_PATH)

    con.execute(
        """
        CREATE TABLE IF NOT EXISTS metadata (
            key TEXT PRIMARY KEY,
            value TEXT
        )
        """
    )

    con.execute(
        """
        CREATE VIRTUAL TABLE IF NOT EXISTS chunks
        USING fts5(
            source UNINDEXED,
            chunk_no UNINDEXED,
            heading,
            content,
            tokenize='unicode61 remove_diacritics 2'
        )
        """
    )

    return con


def build_index():
    SOURCE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    con = _connect()

    con.execute("DELETE FROM chunks")
    con.execute("DELETE FROM metadata")

    supported = {
        ".docx",
        ".md",
        ".txt",
    }

    documents = 0
    chunks_total = 0
    skipped = []

    for path in sorted(
        SOURCE_DIR.rglob("*")
    ):
        if not path.is_file():
            continue

        if path.suffix.lower() not in supported:
            skipped.append(
                str(
                    path.relative_to(
                        SOURCE_DIR
                    )
                )
            )
            continue

        try:
            blocks = read_document(path)
            chunks = make_chunks(blocks)

        except Exception as exc:
            print(
                f"ERROR {path.name}: {exc}"
            )
            continue

        relative = str(
            path.relative_to(SOURCE_DIR)
        )

        for index, chunk in enumerate(
            chunks,
            start=1,
        ):
            con.execute(
                """
                INSERT INTO chunks(
                    source,
                    chunk_no,
                    heading,
                    content
                )
                VALUES (?, ?, ?, ?)
                """,
                (
                    relative,
                    index,
                    chunk["heading"],
                    chunk["content"],
                ),
            )

        documents += 1
        chunks_total += len(chunks)

        print(
            f"INDEXED: {relative} "
            f"blocks={len(blocks)} "
            f"chunks={len(chunks)}"
        )

    con.execute(
        """
        INSERT INTO metadata(key, value)
        VALUES('indexed_at', ?)
        """,
        (_now(),),
    )

    con.execute(
        """
        INSERT INTO metadata(key, value)
        VALUES('documents', ?)
        """,
        (str(documents),),
    )

    con.execute(
        """
        INSERT INTO metadata(key, value)
        VALUES('chunks', ?)
        """,
        (str(chunks_total),),
    )

    con.commit()
    con.close()

    print()
    print("BUILD COMPLETE")
    print("DOCUMENTS:", documents)
    print("CHUNKS   :", chunks_total)

    if skipped:
        print("SKIPPED  :", len(skipped))

        for item in skipped:
            print(" -", item)


def _make_fts_query(query: str):
    tokens = re.findall(
        r"[A-Za-zА-Яа-яЁё0-9_.-]+",
        query,
    )

    cleaned = []

    for token in tokens:
        token = token.strip(
            "._-"
        )

        if len(token) < 2:
            continue

        # prefix search помогает:
        # плагин -> плагины / плагина
        escaped = token.replace('"', '""')

        cleaned.append(
            f'"{escaped}"*'
        )

    if not cleaned:
        raise ValueError(
            "Search query contains no useful tokens"
        )

    return " OR ".join(cleaned)


def search(
    query: str,
    limit: int = 5,
):
    limit = max(
        1,
        min(int(limit), 20),
    )

    fts_query = _make_fts_query(
        query
    )

    con = _connect()

    rows = con.execute(
        """
        SELECT
            rowid,
            source,
            chunk_no,
            heading,
            content,
            bm25(chunks) AS score
        FROM chunks
        WHERE chunks MATCH ?
        ORDER BY score
        LIMIT ?
        """,
        (
            fts_query,
            limit,
        ),
    ).fetchall()

    con.close()

    result = []

    for row in rows:
        result.append(
            {
                "rowid": row[0],
                "source": row[1],
                "chunk_no": row[2],
                "heading": row[3],
                "content": row[4],
                "score": row[5],
            }
        )

    return result


