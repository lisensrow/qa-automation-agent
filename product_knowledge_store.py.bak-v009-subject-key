import json
import sqlite3
from copy import deepcopy
from datetime import datetime, timezone
from pathlib import Path


DB_PATH = Path(
    "/opt/uqa/product_knowledge/"
    "product_knowledge.db"
)


VALID_STATUSES = {
    "candidate",
    "verified",
    "conflict",
    "deprecated",
}


def _now():
    return datetime.now(
        timezone.utc
    ).isoformat()


def _connect():
    DB_PATH.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    conn = sqlite3.connect(
        DB_PATH
    )

    conn.row_factory = (
        sqlite3.Row
    )

    conn.execute(
        "PRAGMA journal_mode=WAL"
    )

    conn.execute(
        "PRAGMA foreign_keys=ON"
    )

    return conn


def init_db():
    with _connect() as conn:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS facts (
                fact_key TEXT PRIMARY KEY,
                fact_type TEXT NOT NULL,
                statement TEXT NOT NULL,
                data_json TEXT NOT NULL,
                status TEXT NOT NULL,
                first_seen_at TEXT NOT NULL,
                last_seen_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS confirmations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,

                fact_key TEXT NOT NULL,

                job_id TEXT NOT NULL,
                case_id TEXT NOT NULL,
                candidate_id TEXT,

                stand TEXT,
                product_version TEXT,

                server_version TEXT,
                installation_architecture TEXT,
                deployment_version TEXT,
                desired_deployment_version TEXT,
                deployment_partial INTEGER,
                stand_identity_json TEXT,

                verification_json TEXT NOT NULL,
                source_observation_ids_json TEXT NOT NULL,

                created_at TEXT NOT NULL,
                last_seen_at TEXT NOT NULL,

                FOREIGN KEY (
                    fact_key
                )
                REFERENCES facts(
                    fact_key
                )
                ON DELETE CASCADE,

                UNIQUE(
                    fact_key,
                    job_id,
                    case_id
                )
            );

            CREATE INDEX IF NOT EXISTS
            idx_confirmations_fact_key
            ON confirmations(
                fact_key
            );

            CREATE INDEX IF NOT EXISTS
            idx_confirmations_stand
            ON confirmations(
                stand
            );

            CREATE INDEX IF NOT EXISTS
            idx_facts_status
            ON facts(
                status
            );
            """
        )



def _ensure_confirmation_identity_columns():
    columns = (
        ("server_version", "TEXT"),
        ("installation_architecture", "TEXT"),
        ("deployment_version", "TEXT"),
        ("desired_deployment_version", "TEXT"),
        ("deployment_partial", "INTEGER"),
        ("stand_identity_json", "TEXT"),
    )

    with _connect() as conn:
        existing = {
            row[1]
            for row in conn.execute(
                "PRAGMA table_info(confirmations)"
            ).fetchall()
        }

        for name, column_type in columns:
            if name in existing:
                continue

            conn.execute(
                f"ALTER TABLE confirmations "
                f"ADD COLUMN {name} {column_type}"
            )


def migrate_confirmation_identity_schema():
    init_db()
    _ensure_confirmation_identity_columns()


def ingest_candidate(
    job_id: str,
    case_id: str,
    stand: str,
    candidate: dict,
    product_version: str = None,
    stand_identity: dict = None,
):
    init_db()
    _ensure_confirmation_identity_columns()
    migrate_fact_scopes_schema()

    stand_identity = (
        stand_identity
        if isinstance(stand_identity, dict)
        else {}
    )

    server_version = stand_identity.get(
        "server_version"
    )

    installation_architecture = (
        stand_identity.get(
            "installation_architecture"
        )
    )

    deployment_version = (
        stand_identity.get(
            "deployment_version"
        )
    )

    desired_deployment_version = (
        stand_identity.get(
            "desired_deployment_version"
        )
    )

    deployment_partial = stand_identity.get(
        "deployment_partial"
    )

    if deployment_partial is not None:
        deployment_partial = int(
            bool(deployment_partial)
        )

    stand_identity_json = (
        json.dumps(
            stand_identity,
            ensure_ascii=False,
            sort_keys=True,
        )
        if stand_identity
        else None
    )

    fact_key = candidate.get(
        "fact_key"
    )

    if not fact_key:
        raise ValueError(
            "candidate has no fact_key"
        )

    fact_type = candidate.get(
        "fact_type"
    )

    statement = candidate.get(
        "statement"
    )

    data = candidate.get(
        "data"
    ) or {}

    verification = candidate.get(
        "verification"
    ) or {}

    source_ids = candidate.get(
        "source_observation_ids"
    ) or []

    now = _now()

    with _connect() as conn:
        existing = conn.execute(
            """
            SELECT *
            FROM facts
            WHERE fact_key = ?
            """,
            (
                fact_key,
            ),
        ).fetchone()

        if existing is None:
            conn.execute(
                """
                INSERT INTO facts (
                    fact_key,
                    fact_type,
                    statement,
                    data_json,
                    status,
                    first_seen_at,
                    last_seen_at
                )
                VALUES (?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    fact_key,
                    fact_type,
                    statement,
                    json.dumps(
                        data,
                        ensure_ascii=False,
                        sort_keys=True,
                    ),
                    "candidate",
                    now,
                    now,
                ),
            )

        else:
            # Один fact_key должен означать
            # одну и ту же каноническую сущность.
            # Пока обновляем формулировку и last_seen,
            # но статус самостоятельно не повышаем.
            conn.execute(
                """
                UPDATE facts
                SET statement = ?,
                    data_json = ?,
                    last_seen_at = ?
                WHERE fact_key = ?
                """,
                (
                    statement,
                    json.dumps(
                        data,
                        ensure_ascii=False,
                        sort_keys=True,
                    ),
                    now,
                    fact_key,
                ),
            )

        conn.execute(
            """
            INSERT INTO confirmations (
                fact_key,
                job_id,
                case_id,
                candidate_id,
                stand,
                product_version,
                server_version,
                installation_architecture,
                deployment_version,
                desired_deployment_version,
                deployment_partial,
                stand_identity_json,
                verification_json,
                source_observation_ids_json,
                created_at,
                last_seen_at
            )
            VALUES (
                ?, ?, ?, ?, ?, ?, ?, ?,
                ?, ?, ?, ?, ?, ?, ?, ?
            )

            ON CONFLICT(
                fact_key,
                job_id,
                case_id
            )
            DO UPDATE SET
                candidate_id =
                    excluded.candidate_id,

                stand =
                    excluded.stand,

                product_version =
                    excluded.product_version,

                server_version =
                    excluded.server_version,

                installation_architecture =
                    excluded.installation_architecture,

                deployment_version =
                    excluded.deployment_version,

                desired_deployment_version =
                    excluded.desired_deployment_version,

                deployment_partial =
                    excluded.deployment_partial,

                stand_identity_json =
                    excluded.stand_identity_json,

                verification_json =
                    excluded.verification_json,

                source_observation_ids_json =
                    excluded.source_observation_ids_json,

                last_seen_at =
                    excluded.last_seen_at
            """,
            (
                fact_key,
                job_id,
                case_id,
                candidate.get(
                    "candidate_id"
                ),
                stand,
                product_version,
                server_version,
                installation_architecture,
                deployment_version,
                desired_deployment_version,
                deployment_partial,
                stand_identity_json,
                json.dumps(
                    verification,
                    ensure_ascii=False,
                    sort_keys=True,
                ),
                json.dumps(
                    source_ids,
                    ensure_ascii=False,
                ),
                now,
                now,
            ),
        )

        _upsert_fact_scope(
            conn=conn,
            fact_key=fact_key,
            installation_architecture=(
                installation_architecture
            ),
            server_version=server_version,
            now=now,
        )

    return get_fact(
        fact_key
    )


def get_fact(
    fact_key: str,
):
    migrate_fact_scopes_schema()

    with _connect() as conn:
        row = conn.execute(
            """
            SELECT *
            FROM facts
            WHERE fact_key = ?
            """,
            (
                fact_key,
            ),
        ).fetchone()

        if row is None:
            return None

        confirmations = (
            conn.execute(
                """
                SELECT *
                FROM confirmations
                WHERE fact_key = ?
                ORDER BY created_at
                """,
                (
                    fact_key,
                ),
            )
            .fetchall()
        )

        scopes = (
            conn.execute(
                """
                SELECT *
                FROM fact_scopes
                WHERE fact_key = ?
                ORDER BY
                    installation_architecture,
                    server_version
                """,
                (
                    fact_key,
                ),
            )
            .fetchall()
        )

    result = dict(row)

    # facts.status оставляем в БД только
    # для обратной совместимости старой схемы.
    # Источником истины он больше не является.
    result["legacy_status"] = result.pop(
        "status",
        None,
    )

    result["data"] = json.loads(
        result.pop(
            "data_json"
        )
    )

    result["confirmations"] = []

    stands = set()

    for item in confirmations:
        confirmation = dict(item)

        confirmation[
            "verification"
        ] = json.loads(
            confirmation.pop(
                "verification_json"
            )
        )

        confirmation[
            "source_observation_ids"
        ] = json.loads(
            confirmation.pop(
                "source_observation_ids_json"
            )
        )

        if confirmation.get(
            "stand"
        ):
            stands.add(
                confirmation[
                    "stand"
                ]
            )

        result[
            "confirmations"
        ].append(
            confirmation
        )

    result[
        "confirmation_count"
    ] = len(
        result["confirmations"]
    )

    result[
        "distinct_stand_count"
    ] = len(
        stands
    )

    result[
        "stands"
    ] = sorted(
        stands
    )

    result["scopes"] = [
        dict(scope)
        for scope in scopes
    ]

    result["scope_count"] = len(
        result["scopes"]
    )

    return deepcopy(
        result
    )

def set_fact_status(
    fact_key: str,
    status: str,
):
    raise RuntimeError(
        "Global facts.status is legacy. "
        "Fact status must be managed "
        "through fact_scopes."
    )

def list_facts(
    status: str = None,
    server_version: str = None,
    installation_architecture: str = None,
    limit: int = 100,
):
    """
    Возвращает semantic facts.

    Если указан status/server_version/
    installation_architecture, фильтрация
    выполняется через fact_scopes.

    facts.status здесь не используется.
    """

    migrate_fact_scopes_schema()

    try:
        limit = int(limit)
    except Exception:
        limit = 100

    limit = max(
        1,
        min(limit, 1000),
    )

    if status is not None:
        status = (
            str(status)
            .strip()
            .lower()
        )

        if status not in VALID_STATUSES:
            raise ValueError(
                f"invalid status: {status}"
            )

    if server_version is not None:
        server_version = (
            str(server_version)
            .strip()
        ) or None

    if installation_architecture is not None:
        installation_architecture = (
            str(
                installation_architecture
            )
            .strip()
            .lower()
        ) or None

    use_scope_filter = any(
        value is not None
        for value in (
            status,
            server_version,
            installation_architecture,
        )
    )

    with _connect() as conn:
        if not use_scope_filter:
            rows = conn.execute(
                """
                SELECT fact_key
                FROM facts
                ORDER BY last_seen_at DESC
                LIMIT ?
                """,
                (
                    limit,
                ),
            ).fetchall()

        else:
            conditions = []
            params = []

            if status is not None:
                conditions.append(
                    "s.status = ?"
                )
                params.append(
                    status
                )

            if server_version is not None:
                conditions.append(
                    "s.server_version = ?"
                )
                params.append(
                    server_version
                )

            if installation_architecture is not None:
                conditions.append(
                    "s.installation_architecture = ?"
                )
                params.append(
                    installation_architecture
                )

            where_sql = " AND ".join(
                conditions
            )

            sql = f"""
                SELECT DISTINCT
                    f.fact_key,
                    f.last_seen_at
                FROM facts AS f
                JOIN fact_scopes AS s
                  ON s.fact_key = f.fact_key
                WHERE {where_sql}
                ORDER BY f.last_seen_at DESC
                LIMIT ?
            """

            params.append(
                limit
            )

            rows = conn.execute(
                sql,
                tuple(params),
            ).fetchall()

    return [
        get_fact(
            row["fact_key"]
        )
        for row in rows
    ]

def migrate_fact_scopes_schema():
    """
    Добавляет version-scoped состояние фактов.

    Scope знания:
        fact_key
        + installation_architecture
        + server_version

    deployment_version намеренно НЕ входит в scope:
    это metadata конкретного deployment/run.
    """

    init_db()
    _ensure_confirmation_identity_columns()

    with _connect() as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS fact_scopes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,

                fact_key TEXT NOT NULL,

                installation_architecture TEXT NOT NULL,
                server_version TEXT NOT NULL,

                status TEXT NOT NULL DEFAULT 'candidate',

                first_seen_at TEXT NOT NULL,
                last_seen_at TEXT NOT NULL,

                verified_at TEXT,
                conflict_at TEXT,
                deprecated_at TEXT,

                FOREIGN KEY (
                    fact_key
                )
                REFERENCES facts(
                    fact_key
                )
                ON DELETE CASCADE,

                UNIQUE(
                    fact_key,
                    installation_architecture,
                    server_version
                )
            )
            """
        )

        conn.execute(
            """
            CREATE INDEX IF NOT EXISTS
            idx_fact_scopes_fact_key
            ON fact_scopes(
                fact_key
            )
            """
        )

        conn.execute(
            """
            CREATE INDEX IF NOT EXISTS
            idx_fact_scopes_version
            ON fact_scopes(
                installation_architecture,
                server_version
            )
            """
        )

        conn.execute(
            """
            CREATE INDEX IF NOT EXISTS
            idx_fact_scopes_status
            ON fact_scopes(
                installation_architecture,
                server_version,
                status
            )
            """
        )

        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS
            fact_scope_status_events (
                id INTEGER PRIMARY KEY AUTOINCREMENT,

                scope_id INTEGER NOT NULL,
                fact_key TEXT NOT NULL,

                installation_architecture TEXT NOT NULL,
                server_version TEXT NOT NULL,

                from_status TEXT NOT NULL,
                to_status TEXT NOT NULL,

                source TEXT,
                reason TEXT,

                job_id TEXT,
                case_id TEXT,

                decision_json TEXT,

                created_at TEXT NOT NULL,

                FOREIGN KEY (
                    scope_id
                )
                REFERENCES fact_scopes(
                    id
                )
                ON DELETE CASCADE
            )
            """
        )

        conn.execute(
            """
            CREATE INDEX IF NOT EXISTS
            idx_fact_scope_status_events_scope
            ON fact_scope_status_events(
                scope_id,
                created_at
            )
            """
        )

        conn.execute(
            """
            CREATE INDEX IF NOT EXISTS
            idx_fact_scope_status_events_fact
            ON fact_scope_status_events(
                fact_key,
                installation_architecture,
                server_version,
                created_at
            )
            """
        )

        event_columns = {
            row[1]
            for row in conn.execute(
                """
                PRAGMA table_info(
                    fact_scope_status_events
                )
                """
            ).fetchall()
        }

        if "decision_json" not in event_columns:
            conn.execute(
                """
                ALTER TABLE
                    fact_scope_status_events
                ADD COLUMN
                    decision_json TEXT
                """
            )

        now = _now()

        rows = conn.execute(
            """
            SELECT DISTINCT
                fact_key,
                installation_architecture,
                server_version
            FROM confirmations
            WHERE installation_architecture IS NOT NULL
              AND server_version IS NOT NULL
              AND TRIM(installation_architecture) != ''
              AND TRIM(server_version) != ''
            """
        ).fetchall()

        for row in rows:
            conn.execute(
                """
                INSERT INTO fact_scopes (
                    fact_key,
                    installation_architecture,
                    server_version,
                    status,
                    first_seen_at,
                    last_seen_at
                )
                VALUES (?, ?, ?, 'candidate', ?, ?)

                ON CONFLICT(
                    fact_key,
                    installation_architecture,
                    server_version
                )
                DO NOTHING
                """,
                (
                    row["fact_key"],
                    row["installation_architecture"],
                    row["server_version"],
                    now,
                    now,
                ),
            )



def _upsert_fact_scope(
    conn,
    fact_key: str,
    installation_architecture: str,
    server_version: str,
    now: str,
):
    if not installation_architecture:
        return

    if not server_version:
        return

    conn.execute(
        """
        INSERT INTO fact_scopes (
            fact_key,
            installation_architecture,
            server_version,
            status,
            first_seen_at,
            last_seen_at
        )
        VALUES (?, ?, ?, 'candidate', ?, ?)

        ON CONFLICT(
            fact_key,
            installation_architecture,
            server_version
        )
        DO UPDATE SET
            last_seen_at =
                excluded.last_seen_at
        """,
        (
            fact_key,
            installation_architecture,
            server_version,
            now,
            now,
        ),
    )


def get_fact_scopes(
    fact_key: str,
):
    migrate_fact_scopes_schema()

    with _connect() as conn:
        rows = conn.execute(
            """
            SELECT *
            FROM fact_scopes
            WHERE fact_key = ?
            ORDER BY
                installation_architecture,
                server_version
            """,
            (
                fact_key,
            ),
        ).fetchall()

    return [
        dict(row)
        for row in rows
    ]


def set_fact_scope_status(
    fact_key: str,
    installation_architecture: str,
    server_version: str,
    status: str,
    source: str = "manual",
    reason: str = None,
    job_id: str = None,
    case_id: str = None,
    decision: dict = None,
):
    """
    Меняет статус только конкретного version scope.

    last_seen_at намеренно НЕ изменяется:
    он отражает время последнего evidence.
    """

    migrate_fact_scopes_schema()

    status = (
        str(status)
        .strip()
        .lower()
    )

    if status not in VALID_STATUSES:
        raise ValueError(
            f"invalid status: {status}"
        )

    installation_architecture = (
        str(installation_architecture)
        .strip()
        .lower()
    )

    server_version = (
        str(server_version)
        .strip()
    )

    if not installation_architecture:
        raise ValueError(
            "installation_architecture is required"
        )

    if not server_version:
        raise ValueError(
            "server_version is required"
        )

    now = _now()

    decision_json = (
        json.dumps(
            decision,
            ensure_ascii=False,
            sort_keys=True,
        )
        if isinstance(decision, dict)
        else None
    )

    with _connect() as conn:
        scope = conn.execute(
            """
            SELECT *
            FROM fact_scopes
            WHERE fact_key = ?
              AND installation_architecture = ?
              AND server_version = ?
            """,
            (
                fact_key,
                installation_architecture,
                server_version,
            ),
        ).fetchone()

        if scope is None:
            raise KeyError(
                (
                    fact_key,
                    installation_architecture,
                    server_version,
                )
            )

        from_status = scope["status"]

        if from_status == status:
            result = dict(scope)
            result["changed"] = False
            result["event_id"] = None
            return result

        timestamp_column = None

        if status == "verified":
            timestamp_column = "verified_at"

        elif status == "conflict":
            timestamp_column = "conflict_at"

        elif status == "deprecated":
            timestamp_column = "deprecated_at"

        if timestamp_column:
            conn.execute(
                f"""
                UPDATE fact_scopes
                SET status = ?,
                    {timestamp_column} = ?
                WHERE id = ?
                """,
                (
                    status,
                    now,
                    scope["id"],
                ),
            )

        else:
            conn.execute(
                """
                UPDATE fact_scopes
                SET status = ?
                WHERE id = ?
                """,
                (
                    status,
                    scope["id"],
                ),
            )

        cursor = conn.execute(
            """
            INSERT INTO fact_scope_status_events (
                scope_id,
                fact_key,
                installation_architecture,
                server_version,
                from_status,
                to_status,
                source,
                reason,
                job_id,
                case_id,
                decision_json,
                created_at
            )
            VALUES (
                ?, ?, ?, ?, ?, ?,
                ?, ?, ?, ?, ?, ?
            )
            """,
            (
                scope["id"],
                fact_key,
                installation_architecture,
                server_version,
                from_status,
                status,
                source,
                reason,
                job_id,
                case_id,
                decision_json,
                now,
            ),
        )

        updated = conn.execute(
            """
            SELECT *
            FROM fact_scopes
            WHERE id = ?
            """,
            (
                scope["id"],
            ),
        ).fetchone()

        result = dict(updated)
        result["changed"] = True
        result["event_id"] = (
            cursor.lastrowid
        )

        return result


def get_fact_scope_status_history(
    fact_key: str,
    installation_architecture: str,
    server_version: str,
):
    migrate_fact_scopes_schema()

    installation_architecture = (
        str(installation_architecture)
        .strip()
        .lower()
    )

    server_version = (
        str(server_version)
        .strip()
    )

    with _connect() as conn:
        rows = conn.execute(
            """
            SELECT *
            FROM fact_scope_status_events
            WHERE fact_key = ?
              AND installation_architecture = ?
              AND server_version = ?
            ORDER BY id
            """,
            (
                fact_key,
                installation_architecture,
                server_version,
            ),
        ).fetchall()

    result = []

    for row in rows:
        item = dict(row)

        raw_decision = item.pop(
            "decision_json",
            None,
        )

        item["decision"] = (
            json.loads(raw_decision)
            if raw_decision
            else None
        )

        result.append(
            item
        )

    return result
